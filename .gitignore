# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, but the template must be,
# since it documents every variable the 17-module build needs.
.env*
!.env.local.example

# Credential files that have been used during setup and must never be
# committed. Listed explicitly rather than relying on .env* — a connection
# string or a key dump does not have to be named ".env" to be a secret, and the
# cost of one of these reaching a public repo is a rotated project at best.
*.pem
*.key
*.p12
*credentials*.json
.supabase-db-url
supabase/.temp/
supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
