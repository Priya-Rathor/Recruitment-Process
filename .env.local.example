# Supabase (Settings > API in your Supabase project dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by admin/server-only
# operations (e.g. the Module 4 "Delete Candidate Data" erasure action).
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider behind the internal AI Service Layer (lib/ai/, built starting
# Module 6). Swappable later per the spec's AI Architecture Pattern.
OPENAI_API_KEY=

# Bolna AI (voice screening calls) — Module 8.
# The API key itself is NOT set here: it is stored per organization, encrypted,
# in organization_integrations. These are the server-side settings around it.
#
# Encrypts integration credentials at rest (32+ characters). Without it the
# adapters refuse to connect rather than storing secrets in the clear.
INTEGRATION_ENCRYPTION_KEY=
# Shared secret Bolna signs its webhooks with. Without it the webhook endpoint
# rejects everything — an unauthenticated endpoint that writes transcripts would
# otherwise let anyone forge a candidate's answers.
BOLNA_WEBHOOK_SECRET=
# Override only if Bolna gives you a non-default API host.
BOLNA_BASE_URL=

# n8n (workflow/automation orchestration) — wired starting Module 13.
N8N_WEBHOOK_URL=
