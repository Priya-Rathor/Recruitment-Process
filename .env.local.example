# Supabase (Settings > API in your Supabase project dashboard)
#
# TWO GENERATIONS OF KEY NAMES ARE ACCEPTED, and lib/supabase/env.ts prefers the
# current pair. A project created today issues the current names; an older one
# still shows the legacy pair. Set ONE pair — setting the wrong one for your
# project fails at sign-in with "Invalid API key" and nothing pointing at why.
NEXT_PUBLIC_SUPABASE_URL=

# Current names (sb_publishable_… / sb_secret_…) — prefer these.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy names (JWTs beginning "eyJ…"), still accepted as a fallback.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Whichever pair you use: the publishable/anon key is safe in a browser and is
# constrained by RLS. The secret/service-role key BYPASSES RLS and must never
# reach the browser or a NEXT_PUBLIC_ name.

# LLM provider behind the internal AI Service Layer (lib/ai/, built starting
# Module 6). Swappable later per the spec's AI Architecture Pattern.
OPENAI_API_KEY=
# Override the provider host and model. Both are optional — lib/ai/provider.ts
# has defaults. Set AI_BASE_URL to point at any OpenAI-compatible endpoint
# (a proxy, a self-hosted gateway, a different vendor) without a code change.
AI_BASE_URL=
AI_MODEL=

# Bolna AI (voice screening calls) — Module 8.
# The API key itself is NOT set here: it is stored per organization, encrypted,
# in organization_integrations. These are the server-side settings around it.
#
# Encrypts integration credentials at rest (32+ characters). Without it the
# adapters refuse to connect rather than storing secrets in the clear.
INTEGRATION_ENCRYPTION_KEY=
# Shared secret Bolna signs its webhooks with. Without it the webhook endpoint
# rejects everything — an unauthenticated endpoint that writes transcripts would
# otherwise let anyone forge a candidate's answers.
BOLNA_WEBHOOK_SECRET=
# Override only if Bolna gives you a non-default API host.
BOLNA_BASE_URL=
# Voice-agent catalogue endpoints (Module 24), as comma-separated `kind:path`
# pairs. Optional: the console tries a documented list in order and shows an
# honest degraded state if none answers. Set this only when the provider renames
# an endpoint, so a fix does not need a deploy.
BOLNA_CATALOG_PATHS=

# Google Calendar OAuth — Module 17. Both come from a Google Cloud project's
# OAuth client. The redirect URI registered there must be exactly:
#   http://localhost:3000/api/settings/integrations/calendar/callback
# Leave blank to run without Calendar: interviews still schedule, no invites go
# out, and the settings page says so.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email provider (Resend-compatible) — Module 15. Override only for a non-
# default API host; the key itself is stored per organization, encrypted.
EMAIL_API_URL=

# WhatsApp Business (Meta Cloud API) — Module 15's candidate messaging.
# The access token and phone number ID are stored PER ORGANIZATION, encrypted, in
# organization_integrations — connect them under Settings → Integrations. Override
# this only to pin a different Graph API version or route through a proxy.
#
# Leave WhatsApp unconfigured entirely and everything still works: email-only
# templates send normally, and a WhatsApp send is recorded as "not sent" with the
# reason rather than failing anything.
WHATSAPP_API_URL=

# Public origin, for the unsubscribe link in automated candidate emails — Module 15.
#
# Normally unnecessary: a send caused by a request takes the origin from that
# request. This is the fallback for a send with no request behind it. Without
# either, the email footer degrades to "reply and ask to be removed" rather than
# emitting a link a mail client cannot follow.
#
# The unsubscribe link is signed with INTEGRATION_ENCRYPTION_KEY above. With no
# key set, no link is issued at all — a dead unsubscribe link is worse than an
# instruction to a human, because the candidate believes they have opted out.
APP_URL=

# n8n (workflow/automation orchestration) — monitored from Module 17.
# Automations execute in-process, not through n8n.
N8N_WEBHOOK_URL=

# =============================================================================
# THE SCHEDULER — REQUIRED IN PRODUCTION.
# =============================================================================
#
# vercel.json defines exactly one cron: GET /api/automations/sweep every five
# minutes. THE PRODUCT HAS ONE CLOCK and this is it — stale-stage rules,
# approval expiry, interview reminders and every "wait, then…" delay drain from
# that single sweep.
#
# The route refuses the cron path when this is unset — a 503, deliberately, so
# an unauthenticated endpoint that runs every organization's automations is
# never open by default. WITH IT UNSET, NOTHING TIME-BASED EVER FIRES, and the
# symptom is silence rather than an error anyone sees.
#
# Any long random string. Generate one with:  openssl rand -base64 32
# On Vercel, add it to the project's environment variables; Vercel Cron sends it
# automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
